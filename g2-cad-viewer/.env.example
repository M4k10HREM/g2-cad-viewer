# OPTIONAL, for your own development only. Normally each user enters their keys
# in the app's Settings panel (stored on their phone, never in the package).
# Values here are used ONLY by `npm run dev`; production builds/packs ignore them.
# Copy to `.env.local` to use. Never commit `.env.local`.

# ── Voice commands (optional — touch controls work without this) ──────
# Built-in provider: deepgram (https://deepgram.com). To use another provider,
# implement it in src/asr/stt.ts and add its host to app.json's network whitelist.
# elevenlabs (uses your Worker, see SETUP-AI.md) or deepgram (needs VITE_STT_API_KEY)
VITE_STT_PROVIDER=elevenlabs
VITE_STT_API_KEY=

# ── AI design / text-to-CAD (optional) ────────────────────────────────
# Your Cloudflare Worker from ../g2-cad-ai-worker (see SETUP-AI.md).
# VITE_AI_URL example: https://g2-cad-ai.your-name.workers.dev
VITE_AI_URL=
# Must equal the APP_TOKEN secret you set on the Worker.
VITE_AI_TOKEN=
